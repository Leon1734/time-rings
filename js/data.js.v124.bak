      ['前27年', '罗马帝国开始', '前221年 秦统一中国'],
      ['476年', '西罗马帝国灭亡', '581年 隋唐开启盛世'],
      ['1453年', '君士坦丁堡陷落', '1405年 郑和首下西洋'],
      ['1610年', '伽利略观测星空', '1637年 《天工开物》成书'],
      ['1769年', '瓦特改良蒸汽机', '1840年 鸦片战争开启近代']
    ],
    calendarIntro: '卡尔·萨根提出过一个著名的思想实验：把宇宙138亿年压缩成一个"宇宙年"（1月1日0点=大爆炸，12月31日24点=现在），我们会得到惊人的视角——',
    calendarNote: '（本页事件按线性比例换算：每宇宙1天≈3781万年，每宇宙1秒≈438年）'
  };

  /* ================= 帮助 ================= */
  const HELP = [
    ['拖拽 / 滚轮 / 右键拖拽', '环绕 / 缩放 / 平移（航拍视角）'],
    ['🎬 飞览全程', '从源头自动飞到入海口（约45秒）；飞览中再点一次=暂停飞览'],
    ['⏸ 暂停 / 空格（轻点）/ P', '时间凝固：水流、波浪、河灯与飞览全部暂停，再按继续'],
    ['按住空格 + 左键拖拽', '平移画面（抓手视图；飞览中同样可用）'],
    ['拖动顶部进度条', '任意跳转航程（像视频一样拖动，自动进入暂停态）'],
    ['← →', '沿河小幅后退 / 前进'],
    ['🗺 全河鸟瞰', '升到高空，看整条大河的蜿蜒全貌'],
    ['单击河灯', '原地弹出事件档案卡（含宇宙日历与同时代事件），不移动镜头'],
    ['单击纪元年表 / 石拱门标签', '镜头飞往该河段 + 打开纪元卡'],
    ['飞览中拖拽画面', '随时接管镜头，自由沿岸浏览'],
    ['图例点击', '按类别筛选：宇宙 / 地球 / 生命 / 文明 / 科学 / 艺术'],
    ['搜索框', '关键词查找河灯，回车直接飞过去'],
    ['信息窗配图', '联网时自动加载维基百科图片；离线显示类别/纪元图腾'],
    ['🎙 导览', '语音解说：飞览播报纪元，单击河灯播报事件（再次点击关闭）'],
    ['🔊 水声', '环境流水声（浏览器合成，暂停时自动减弱）'],
    ['🌗 昼夜', '切换白天 / 星夜两种渲染氛围'],
    ['🏆 问答', '寻宝模式：按线索（类别/纪元/年代）找到目标河灯，连对计分'],
    ['🎥 录制', '录制飞览全程为 webm 视频，到达入海口后自动下载（无声音）'],
    ['🔗 分享定位', '单击河灯后地址栏链接即携带定位，发给他人打开直达该事件'],
    ['刻度切换', '深时全景（对数河道）/ 文明时代 / 近现代（线性河道）']
  ];

  /* ================= 工具：年代格式化 ================= */
  function fmtAgo(ago) {
    if (ago <= 0) return '今天';
    if (ago < 1) return '今年';
    const y = Math.round(ago);
    if (y <= NOW_YEAR) return '公元' + (NOW_YEAR - y) + '年';
    const bce = y - NOW_YEAR;
    if (y < 1e4) return '公元前' + bce + '年';
    if (y < 1e8) return Math.round(y / 1e4) + '万年前';
    const v = y / 1e8;
    return (v >= 100 ? Math.round(v) : +v.toFixed(1)) + '亿年前';
  }

  /* ================= 工具：宇宙日历 =================
   * 138亿年 → 一个"宇宙年"（线性映射，萨根宇宙日历）。
   * 采用 365 天制：1 宇宙日 ≈ 3781万年，1 宇宙秒 ≈ 437.6 年 */
  function cosmicDate(ago) {
    if (ago <= 0.5) return '12月31日 24:00（此刻）';
    const MAXS = 365 * 86400;
    const sec = Math.min(MAXS - 0.001, Math.max(0, 1 - ago / T_UNIVERSE) * MAXS);
    const day = Math.floor(sec / 86400);
    const rem = sec - day * 86400;
    const hh = Math.floor(rem / 3600);
    const mm = Math.floor((rem % 3600) / 60);
    const ss = Math.floor(rem % 60);
    const CUM = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334];
    let m = 11;
    while (m > 0 && day < CUM[m]) m--;
    let d = day - CUM[m];
    if (d >= 31) d = 30;                       // 年末余量并入 12 月
    let t = pad(hh) + ':' + pad(mm);
    if (hh === 23 && mm === 59) t += ':' + pad(ss);
    return (m + 1) + '月' + (d + 1) + '日 ' + t;
    function pad(n) { return (n < 10 ? '0' : '') + n; }
  }
  /* 宇宙日历 1秒 = 多少年 */
  const COSMIC_SEC_YEARS = T_UNIVERSE / (365 * 86400);

  return {
    NOW_YEAR: NOW_YEAR, T_UNIVERSE: T_UNIVERSE,
    CATS: CATS, MODES: MODES, ERAS: ERAS, EVENTS: EVENTS,
    TIPS: TIPS, SCIENCE: SCIENCE, HELP: HELP,
    eraEmoji: eraEmoji, CAT_EMOJI: CAT_EMOJI,
    fmtAgo: fmtAgo, cosmicDate: cosmicDate, COSMIC_SEC_YEARS: COSMIC_SEC_YEARS
  };
})();
