  /* ================= 时代图腾（岸边大形象） =================
   * 按纪元名关键词匹配 emoji；顺序敏感（具体词在前） */
  const ERA_EMOJI = [
    ['恐龙', '🦕'], ['古生代', '🐟'], ['真核', '🦠'], ['生命黎明', '🧬'],
    ['原初', '💥'], ['星系', '🌌'], ['太阳系', '🌍'], ['新生代', '🐒'],
    ['文明曙光', '🏕️'], ['石器', '🪨'], ['农业', '🌾'], ['青铜', '🏺'],
    ['轴心', '🏛️'], ['帝国', '🏰'], ['中世纪', '🏰'],
    ['大航海', '⛵'], ['文艺复兴', '🖼️'], ['科学革命', '🔭'],
    ['工业', '🏭'], ['世纪之交', '✈️'], ['20世纪中期', '🚀'], ['信息', '💻']
  ];
  function eraEmoji(name) {
    name = name || '';
    for (let i = 0; i < ERA_EMOJI.length; i++) {
      if (name.indexOf(ERA_EMOJI[i][0]) >= 0) return ERA_EMOJI[i][1];
    }
    return '🏞️';
  }
  /* 各类别图腾（信息窗主图） */
  const CAT_EMOJI = { universe: '🌌', earth: '🌍', life: '🧬', civ: '🏛️', sci: '🔬', art: '🎨' };

  /* ================= 底部小知识（滚动条） ================= */
  const TIPS = [
    '如果把宇宙138亿年压缩成1年，人类文字史只占最后的12秒。',
    '树轮一年长一圈：美国狐尾松"玛土撒拉"已近4900岁，是仍在生长的最老树木之一。',
    '你身体里的每一个碳原子，都曾是某颗恒星的一部分——"我们是星星的孩子"是字面意思。',
    '恐龙灭绝的那颗小行星，撞出的陨石坑直径约180公里，一半还埋在海底。',
    '寒武纪大爆发在地质学上只算"一眨眼"，却几乎发明了所有动物的身体蓝图。',
    '大氧化事件让海水里的铁锈沉成条带状铁矿——你身边的钢铁，可能来自24亿年前的阳光。',
    '哺乳动物与恐龙同时起源，却"蛰伏"了1.4亿年才等到主角剧本。',
    '从莱特兄弟首飞到喷气客机，人类只用了66年；再过33年就登上了月球。',
    '伽利略去世次年牛顿出生，接力棒交得恰到好处。',
    '阿波罗登月舱的计算机内存只有4KB——比这张网页的一张图标还小。',
    '《清明上河图》与欧洲十字军东征是同时代的作品。',
    '最早的陶器发现于中国江西，约2万年前——比农业还要早。',
    '线粒体还保留着自己的DNA：你身体里的每个细胞，都是一次远古"合并"的产物。',
    'GPS每天要按相对论修正约38微秒——不修正的话，定位一天能漂出10公里。',
    '引力波探测器能测出质子直径万分之一的形变——相当于量出日地距离精确到一个原子。'
  ];

  /* ================= 科普课堂文案 ================= */
  const SCIENCE = {
    river: [
      '"子在川上曰：逝者如斯夫。"——把时间想象成一条奔流的大河，是东西方共通的古老隐喻。本演示把 138 亿年铺成一条真实的河：<b>源头是宇宙大爆炸，入海口是今天</b>。你以航拍视角俯瞰它的全貌，历史像一幅画卷在脚下展开。',
      '河水按<b>纪元染色</b>：每道<b>跌水瀑布</b>之上横跨一座<b>石拱门</b>，穿过拱门、跌下一级河床，就进入下一个纪元——从"太阳系与地球"跌入"生命黎明"，从"中生代·恐龙"跌入"石器时代"。门与瀑布就是历史的台阶。',
      '水面上漂浮的<b>河灯</b>是历史事件：灯的位置 = 年代，灯色 = 类别，亮灯 = 事件发生。单击任何一盏河灯，即可查看它的档案、趣味知识与"宇宙日历"。',
      '注意河段的"疏密"：上游用<b>对数刻度</b>，同样长的一段河，上游装 1 亿年，下游只装 10 年——这不是扭曲历史，而是如实呈现：人类全部文明史，确实挤在大河的最后一湾。'
    ],
    log: [
      '人类直觉是线性的：1万和10万只差9万，感觉不算夸张。但138亿年与1万年，直觉已完全失效——这叫<b>深时（Deep Time）</b>的眩晕。',
      '于是我们用<b>对数刻度</b>：河道每前进一段，包含的时间就缩短10倍。上游一段装1亿年，下游同长的一段只装10年——下游的"分辨率"比上游精细上千万倍。',
      '这不是扭曲历史，而是"如实地"展示历史：文明史确实挤在宇宙史的最后一瞬。切换到【文明时代】或【近现代】河道，你会发现它们各自又是一条"河灯密布的大河"。'
    ],
    vs: [
      ['约前2560年', '埃及吉萨金字塔', '二里头宫城（约前1750年）'],
