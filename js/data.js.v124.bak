    { id: 'tetrapods', cat: 'life', ago: 3.7e8, imp: 2, title: '登陆先锋·两栖类', en: 'First Tetrapods',
      desc: '肉鳍鱼的鳔演变成肺、鳍演变成四肢，提塔利克鱼们爬上陆地——四足动物时代开始。',
      facts: ['你的四肢五指，源自鱼鳍的骨骼排布', '鲸的鳍与蝙蝠的翼都是同一张"设计图"的变体'] },
    { id: 'coalforests', cat: 'life', ago: 3.3e8, imp: 2, title: '巨虫时代·煤之森林', en: 'Carboniferous Forests',
      desc: '高氧环境催生翼展70厘米的巨脉蜻蜓与百米蕨类森林；它们倒下后被埋进地下，成为今天的煤田。',
      facts: ['石炭纪大气含氧量或达35%（今天约21%）', '燃煤电厂的能量，其实来自3亿年前的阳光'] },
    { id: 'reptiles', cat: 'life', ago: 3.2e8, imp: 2, title: '羊膜动物登场', en: 'First Amniotes',
      desc: '"自带水杯"的羊膜卵让脊椎动物彻底摆脱水边繁殖的束缚，爬行时代开启。',
      facts: ['鸡蛋就是羊膜卵的现代版本', '羊膜动物后来分为蜥形类（恐龙·鸟）与合弓类（我们哺乳类）'] },
    { id: 'permian', cat: 'life', ago: 2.52e8, imp: 2, title: '二叠纪末大灭绝', en: 'Permian Extinction',
      desc: '地球史上最惨烈的灭绝：约96%的海洋物种消失，头号嫌疑人指向西伯利亚超级火山。',
      facts: ['生态系统花了约1000万年才恢复元气', '它是恐龙崛起的"清场前奏"'] },
    { id: 'dinosaurs', cat: 'life', ago: 2.3e8, imp: 2, title: '恐龙时代开启', en: 'Rise of Dinosaurs',
      desc: '三叠纪末，恐龙从大灭绝的废墟中崛起，此后统治地球约1.35亿年。',
      facts: ['最早的恐龙只有狗那么大', '人类与恐龙"隔着"6600万年，恐龙与三叶虫隔得更远'] },
    { id: 'mammals', cat: 'life', ago: 2.1e8, imp: 2, title: '哺乳动物出现', en: 'First Mammals',
      desc: '恐龙脚边的小小"鼩鼱"——摩尔根兽——开始夜行觅食；恒温、哺乳与毛发，看家本领逐步凑齐。',
      facts: ['为躲避恐龙，早期哺乳类多是"夜猫子"，夜视能力遗传至今', '它们与恐龙同时起源，却"装死"了1.4亿年'] },
    { id: 'birds', cat: 'life', ago: 1.5e8, imp: 2, title: '飞上蓝天·始祖鸟', en: 'First Birds',
      desc: '带羽毛的恐龙学会飞行，始祖鸟成为最著名的过渡化石——今天的麻雀就是活的恐龙。',
      facts: ['始祖鸟有牙齿与长骨尾，"恐龙味"十足', '鸟类的单向气流肺比哺乳类更高效'] },
    { id: 'flowers', cat: 'life', ago: 1.3e8, imp: 2, title: '花开大地', en: 'First Flowers',
      desc: '被子植物与传粉昆虫"联手"，花色与花香上演军备竞赛，世界从此五彩缤纷。',
      facts: ['被子植物如今占陆生植物种类的约九成', '琥珀中的花粉记录了白垩纪的"花事"'] },
    { id: 'whales', cat: 'life', ago: 5e7, imp: 2, title: '鲸类重返海洋', en: 'Whales Return to Sea',
      desc: '一种偶蹄类走兽（巴基鲸）下海：前肢成鳍、后肢退化、鼻孔上移——陆生动物反向"回归"海洋。',
      facts: ['鲸的骨盆残余还藏在体内', '蓝鲸的心脏有小汽车那么大'] },
    { id: 'primates', cat: 'life', ago: 2.8e7, imp: 2, title: '灵长类的繁荣', en: 'Primates Flourish',
      desc: '恐龙灭绝后，树上生活让灵长类练出立体视觉与灵巧手指——为"手"与"智慧"埋下伏笔。',
      facts: ['能对握的大拇指是灵长类的标志', '人类与黑猩猩的基因组相似度约98.8%'] },
    { id: 'split', cat: 'life', ago: 6.5e6, imp: 3, title: '人猿分家', en: 'Human–Chimp Split',
      desc: '非洲森林草原化，一支猿类走下树梢，与黑猩猩的祖先分道扬镳——人类世系的起点。',
      facts: ['分子钟与化石证据都指向约600万～700万年前', '分家之后，两支各自演化了600多万年'] },
    { id: 'bipedal', cat: 'life', ago: 4.0e6, imp: 2, title: '直立行走', en: 'Bipedalism',
      desc: '阿法南方古猿"露西"用双脚走路；空出来的双手，日后将握住工具、书写历史。',
      facts: ['露西出土时，营地正播放披头士的《Lucy in the Sky with Diamonds》', '直立行走的代价：人类成为腰椎最"辛苦"的物种之一'] },

    /* ---------- 文明 🏛️ ---------- */
    { id: 'stone', cat: 'civ', ago: 2.6e6, imp: 3, title: '第一批石器', en: 'First Stone Tools',
      desc: '能人在奥杜威峡谷敲打出石器——人类文明的第一个"工具包"上线，技术从此开始改写演化规则。',
      facts: ['这种技术此后近200万年几乎原地踏步', '从打制石器到电脑，"只"隔了约26万个世代'] },
    { id: 'fire', cat: 'civ', ago: 1.0e6, imp: 2, title: '学会用火', en: 'Control of Fire',
      desc: '直立人掌握了火：取暖、照明、驱兽，更重要的是熟食——熟食让肠胃省能、大脑扩容。',
      facts: ['周口店遗址留下约40万年前的用火遗迹（更早证据仍有争议）', '"烹饪假说"认为：吃熟食是大脑变大的助推器'] },
    { id: 'outofafrica1', cat: 'civ', ago: 1.8e6, imp: 2, title: '人类首次走出非洲', en: 'First Out of Africa',
      desc: '直立人带着新工具出走非洲，足迹远达东亚与东南亚（北京人、爪哇人）。',
      facts: ['直立人是走出非洲的"第一代背包客"', '他们会用火、打造手斧，脑容量约为现代人的三分之二'] },
    { id: 'neanderthal', cat: 'civ', ago: 4.0e5, imp: 2, title: '尼安德特人', en: 'Neanderthals',
      desc: '冰河期欧洲的"壮汉近亲"：会用火、做工具、照顾伤员，甚至创作饰品与颜料。',
      facts: ['现代欧亚人基因组含约1%～4%的尼人基因', '他们的脑容量比现代人还略大', '2010年基因组测序证实：我们的祖先曾与他们混血'] },
    { id: 'sapiens', cat: 'civ', ago: 3.0e5, imp: 3, title: '智人出现', en: 'Homo Sapiens',
      desc: '在非洲诞生了会讲故事、能抽象思考的我们——"认知革命"的漫长前奏就此开始。',
      facts: ['今天所有智人都有共同的非洲祖先', '大脑只占体重2%，却消耗全身约20%的能量'] },
    { id: 'outofafrica2', cat: 'civ', ago: 6.0e4, imp: 2, title: '现代智人走出非洲', en: 'The Great Migration',
      desc: '一小群智人离开非洲，数万年间散布各大洲，逐渐取代了沿途的其他人种。',
      facts: ['所有人的线粒体DNA都可追溯到一位非洲"线粒体夏娃"', '约4.5万年前，智人已乘船抵达澳大利亚'] },
    { id: 'dog', cat: 'civ', ago: 1.5e4, imp: 2, title: '驯化狗狗', en: 'Domestication of Dogs',
      desc: '从与狼"搭伙"到形影不离，狗成为人类第一个"驯化工程"与最老的朋友。',
      facts: ['狗能读懂人类的眼神——连近亲黑猩猩都做不到', '狗狗的驯化早于农业：朋友先于面包'] },
    { id: 'gobekli', cat: 'civ', ago: 1.15e4, imp: 2, title: '哥贝克力石阵', en: 'Göbekli Tepe',
      desc: '土耳其安纳托利亚的巨型石阵比金字塔早7000年，石柱上刻着野猪与猛蛇——到底先有神庙，还是先有城市？',
      facts: ['建造者还是狩猎采集者，颠覆了"先农业后祭祀"的猜想', '石阵被古人刻意掩埋，原因至今成谜'] },
    { id: 'agriculture', cat: 'civ', ago: 1.0e4, imp: 3, title: '农业革命', en: 'Agricultural Revolution',
      desc: '新月沃地驯化小麦，长江流域驯化水稻——人类从"觅食"转向"生产"，人口与定居同时起飞。',
      facts: ['农业让单位土地养活的人口提升数十倍', '驯化是双向的：小麦也"驯化"了人类的饮食与作息', '此后几千年，猪、牛、羊陆续加入人类的"合伙人"名单'] },
    { id: 'pottery', cat: 'civ', ago: 2.0e4, imp: 2, title: '最早的陶器', en: 'Earliest Pottery',
      desc: '江西仙人洞出土约2万年前的陶片——陶器早于农业出现，"煮饭神器"提前上岗。',
      facts: ['世界最早的陶器目前发现于中国', '陶片改写了"先农业后有陶"的旧假设'] },
    { id: 'bronze', cat: 'civ', ago: 5.3e3, imp: 2, title: '青铜时代', en: 'The Bronze Age',
      desc: '铜锡合成的青铜更硬更利，专业工匠与远程贸易网络随之出现——"高科技材料"第一次改写世界。',
      facts: ['青铜熔点约800℃，需要成熟的炉窑技术', '商代中国的青铜铸造规模与技术独步古代世界'] },
    { id: 'writing', cat: 'civ', ago: 5.2e3, imp: 3, title: '文字的发明', en: 'Invention of Writing',
      desc: '两河流域的苏美尔人为了记账，把符号刻上泥板——楔形文字诞生，信息第一次突破人脑与口传的边界。',
      facts: ['最早的文字多是"账本"：多少大麦、几只羊', '汉字源自约3300年前的甲骨文，是仍在使用的最古老文字系统', '文字让知识可以累积——文明按下了"存档键"'] },
    { id: 'pyramid', cat: 'civ', ago: 4.6e3, imp: 2, title: '金字塔时代', en: 'Pyramids of Giza',
      desc: '胡夫金字塔以约230万块巨石堆出146米奇迹，此后3800年一直是世界最高建筑。',
      facts: ['石块平均重2.5吨，施工方法至今仍在争论', '金字塔是法老的"永生机器"，也是国家组织力的纪念碑'] },
    { id: 'xia', cn: 1, cat: 'civ', ago: 4.1e3, imp: 1, title: '二里头·最早的广域王权', en: 'Erlitou Culture',
      desc: '河南二里头遗址出现宫殿群与青铜礼器，被不少学者对应文献记载中的夏朝——中国王朝叙事的起点。',
      facts: ['二里头出土了中国最早的宫城中轴线布局', '"夏"的文字记载晚至千年之后，细节仍待考古确认'] },
    { id: 'code', cat: 'civ', ago: 3.8e3, imp: 2, title: '《汉谟拉比法典》', en: 'Code of Hammurabi',
      desc: '巴比伦王汉谟拉比把282条法令刻上黑色玄武岩石柱——成文法公开治国的开始。',
      facts: ['法典石柱现存于巴黎卢浮宫', '条文涵盖工资、医疗事故与婚姻，堪称"古代生活百科"'] },
    { id: 'shang', cn: 1, cat: 'civ', ago: 3.3e3, imp: 2, title: '甲骨文·商朝', en: 'Oracle Bones & the Shang',
      desc: '商王把占卜问题刻在龟甲兽骨上——汉字最早的成熟形态，出土于安阳殷墟。',
      facts: ['已发现约15万片甲骨、单字约4500个', '占卜内容从天气、收成到征伐、生育，是一部"商代生活直播"'] },
    { id: 'iron', cat: 'civ', ago: 3.2e3, imp: 2, title: '铁器时代', en: 'The Iron Age',
      desc: '铁矿远比铜矿常见，铁器让农具与兵器"飞入寻常百姓家"，生产力与战争同时升级。',
      facts: ['早期块炼铁约需1200℃高温锻打成型', '中国战国时期的铸铁技术领先欧洲近两千年'] },
    { id: 'confucius', cn: 1, cat: 'civ', ago: 2.55e3, imp: 3, title: '孔子与诸子百家', en: 'Confucius & the Hundred Schools',
      desc: '春秋乱世，孔子讲"仁"，老子论"道"，墨子倡"兼爱"——中国思想的黄金时代。',
      facts: ['《论语》由弟子辑录，影响东亚2500余年', '同期希腊哲人与印度佛陀遥相呼应——雅斯贝尔斯称之为"轴心时代"'] },
    { id: 'buddha', cat: 'civ', ago: 2.5e3, imp: 2, title: '佛陀与佛教', en: 'The Buddha',
      desc: '悉达多·乔达摩在恒河流域觉悟，创立佛教；它后来沿丝路东传，深刻塑造了亚洲文明。',
      facts: ['佛教与耆那教都诞生于对婆罗门传统的反思', '阿育王的推广让佛教成为世界性宗教'] },
    { id: 'democracy', cat: 'civ', ago: 2.5e3, imp: 2, title: '雅典民主', en: 'Athenian Democracy',
      desc: '克利斯提尼改革让公民抽签参政，"德谟克拉西"（人民的统治）第一次落地。',
      facts: ['公民大会一年约开会40次', '妇女、外邦人与奴隶不在公民之列——古代民主有其边界'] },
    { id: 'qin', cn: 1, cat: 'civ', ago: 2.247e3, imp: 3, title: '秦统一中国', en: 'Qin Unifies China',
      desc: '秦王嬴政扫平六国：书同文、车同轨、统一度量衡，中央集权帝制由此沿用两千年。',
      facts: ['兵马俑千人千面，彩绘工艺至今令人惊叹', '秦直道与长城构成帝国的"高速公路网"', '"皇帝"这一称号一直用到1912年'] },
    { id: 'silkroad', cat: 'civ', ago: 2.15e3, imp: 2, title: '丝绸之路开通', en: 'The Silk Road',
      desc: '张骞凿空西域，驼铃把长安与罗马连在一起——丝绸、造纸、葡萄与佛教在欧亚大陆双向奔赴。',
      facts: ['丝路上最贵重的不是丝绸，而是信息与种子', '"条条大路通罗马"与丝路在西端相遇'] },
    { id: 'archimedes', cat: 'sci', ago: 2.28e3, imp: 2, title: '阿基米德', en: 'Archimedes',
      desc: '"给我一个支点，我能撬动地球"——浮力定律与杠杆原理的定量化先驱，古代最接近"科学家"的人。',
      facts: ['他用排水法鉴定王冠纯度——史上著名"尤里卡时刻"', '阿基米德螺线至今仍在机械中旋转', '他死于罗马士兵之手，遗言是"别踩坏我的圆！"'] },
    { id: 'rome', cat: 'civ', ago: 2.05e3, imp: 2, title: '罗马帝国确立', en: 'The Roman Empire',
      desc: '屋大维获"奥古斯都"尊号，地中海成为"我们的海"；罗马法与条条大路影响至今。',
      facts: ['罗马混凝土含火山灰，在海里越泡越硬', '《十二铜表法》是罗马法系的地基'] },
    { id: 'paper', cn: 1, cat: 'civ', ago: 1.908e3, imp: 2, title: '造纸术改进', en: 'Paper Making',
      desc: '蔡伦改进造纸术，知识载体的成本从此"跳水"，文明传播被按下快进键。',
      facts: ['造纸术在8世纪经怛罗斯之战西传', '纸、印刷、火药、指南针——四大发明改写世界史'] },
    { id: 'zhangheng', cn: 1, cat: 'sci', ago: 1.89e3, imp: 2, title: '张衡地动仪', en: 'Seismoscope of Zhang Heng',
      desc: '张衡造候风地动仪：八条金龙对应八方，机内悬铜丸——百里之外的地震方位皆可测。',
      facts: ['《后汉书》记载陇西地震时洛阳铜丸坠落应验的故事', '张衡还系统阐述浑天说、创作《二京赋》', '地动仪原物失传，今天看到的是后世复原模型'] },
    { id: 'dunhuang', cn: 1, cat: 'art', ago: 1.66e3, imp: 2, title: '敦煌莫高窟开凿', en: 'Mogao Caves',
      desc: '乐僔和尚在鸣沙山见"金光如千佛"，凿下第一窟；此后千年营造，成为4.5万平方米的壁画宝库。',
      facts: ['现存洞窟735个、彩塑2400余尊', '藏经洞文书涉及十来种文字，催生"敦煌学"', '壁画里的青金石颜料来自阿富汗'] },
    { id: 'romanfall', cat: 'civ', ago: 1.55e3, imp: 2, title: '西罗马帝国灭亡', en: 'Fall of Rome',
      desc: '476年，日耳曼将领废黜末代皇帝，西欧进入中世纪；东罗马（拜占庭）再续千年。',
      facts: ['罗马的衰落持续了两个世纪，"不是一天建成的，也不是一天塌掉的"', '君士坦丁堡直到1453年才陷落'] },
    { id: 'tang', cn: 1, cat: 'civ', ago: 1.39e3, imp: 2, title: '盛唐气象', en: 'Tang Golden Age',
      desc: '贞观至开元，长安是百万人口的国际化都市，万国来朝；李白与杜甫先后登场。',
      facts: ['长安城当时是世界最大的都会', '科举制度影响了东亚上千年的文官传统'] },
    { id: 'houseofwisdom', cat: 'sci', ago: 1.2e3, imp: 2, title: '智慧宫·百年翻译运动', en: 'House of Wisdom',
      desc: '阿拔斯王朝在巴格达汇集希腊、波斯、印度典籍并系统翻译——代数学与"0"由此走向世界。',
      facts: ['"算法"（algorithm）一词源自数学家花拉子米的名字', '古希腊典籍经阿拉伯语保存，数百年后回流欧洲', '印度—阿拉伯数字与"0"经此传入西方'] },
    { id: 'movabletype', cn: 1, cat: 'civ', ago: 9.8e2, imp: 2, title: '活字印刷·毕昇', en: 'Movable Type',
      desc: '北宋布衣毕昇以胶泥刻字、火烧令坚、排版印刷——比古腾堡早了400年。',
      facts: ['沈括《梦溪笔谈》详细记录了毕昇的活字法', '朝鲜后来铸出金属活字；古腾堡让它"工业化"'] },
    { id: 'alongriver', cn: 1, cat: 'art', ago: 9.1e2, imp: 2, title: '《清明上河图》', en: 'Along the River During Qingming',
      desc: '张择端描绘北宋汴京的市井长卷：约800个人物、漕船、骆驼队与临街店铺——古代都市生活的"纪录片"。',
      facts: ['画中无柱飞架的虹桥，是中国木拱桥的绝技', '真迹现藏北京故宫博物院'] },
    { id: 'plague', cat: 'civ', ago: 6.78e2, imp: 2, title: '黑死病', en: 'The Black Death',
      desc: '鼠疫沿商路席卷欧亚，欧洲人口锐减约三分之一；旧秩序动摇，新的劳动与思想格局悄然萌生。',
      facts: ['"隔离"（quarantine）源自意大利语的"四十天"', '劳动力短缺反而抬高了欧洲底层劳动者地位'] },
    { id: 'renaissance', cat: 'civ', ago: 6.26e2, imp: 2, title: '文艺复兴', en: 'The Renaissance',
      desc: '从佛罗伦萨出发，欧洲重新发现古希腊罗马——人文主义、透视法与达·芬奇们集体登场。',
      facts: ['"文艺复兴"原意"再生"', '透视法让绘画第一次有了"景深"', '美第奇家族用银行利润投资了这场文化复兴'] },
    { id: 'gutenberg', cat: 'civ', ago: 5.71e2, imp: 2, title: '古腾堡印刷机', en: 'The Printing Press',
      desc: '金属活字＋油墨＋印刷机让书籍成本骤降，知识传播进入"工业化"，宗教改革与科学革命随之加速。',
      facts: ['《四十二行圣经》是西方第一部活字印本', '此后50年，欧洲书产量从数万册跃升至约2000万册'] },
    { id: 'columbus', cat: 'civ', ago: 5.34e2, imp: 2, title: '哥伦布远航', en: 'Columbus Sails West',
      desc: '哥伦布向西寻找亚洲，误打误撞开启"哥伦布大交换"：玉米、土豆西去旧大陆，马匹、小麦与新病毒东渡新大陆。',
      facts: ['约500年前维京人已到过纽芬兰', '大交换重塑了全球餐桌：没有土豆就没有"薯条自由"', '旧大陆病毒让美洲原住民人口锐减——全球化最黑暗的一页'] },
    { id: 'mona', cat: 'art', ago: 5.2e2, imp: 2, title: '《蒙娜丽莎》', en: 'Mona Lisa',
      desc: '达·芬奇以晕涂法画出那抹"似笑非笑"——艺术史上被谈论最多的一幅画。',
      facts: ['达·芬奇同时是解剖学家、工程师与飞行器设计师', '1911年的失窃案让这幅画一夜爆红'] },
    { id: 'copernicus', cat: 'sci', ago: 4.83e2, imp: 3, title: '日心说·《天体运行论》', en: 'Heliocentrism',
      desc: '哥白尼临终出版《天体运行论》，把地球请下宇宙中心——宇宙观革命的第一枪。',
      facts: ['日心说让行星逆行现象变得简单自然', '据说他弥留之际摸到了刚印好的样书', '半个世纪后，伽利略用望远镜为它补上证据'] },
    { id: 'galileo', cat: 'sci', ago: 4.17e2, imp: 2, title: '伽利略的望远镜', en: 'Galileo\'s Telescope',
      desc: '伽利略把望远镜指向夜空：木星的卫星、月面的环形山、金星的相位——天上并没有"完美水晶球"。',
      facts: ['他自制的望远镜放大倍率约20倍', '伽利略去世次年，牛顿出生——接力棒交得很巧'] },
    { id: 'newton', cat: 'sci', ago: 3.39e2, imp: 3, title: '牛顿《自然哲学的数学原理》', en: 'Principia Mathematica',
      desc: '三大运动定律＋万有引力，天上地下统一于数学——经典物理学的"总章程"问世。',
      facts: ['哈雷自掏腰包资助出版，彗星因此以他命名', '牛顿还发明了反射望远镜与微积分', '这套力学主导航天250年——阿波罗登月也靠它'] },
    { id: 'watt', cat: 'civ', ago: 2.5e2, imp: 2, title: '瓦特蒸汽机', en: 'Watt\'s Steam Engine',
      desc: '瓦特加装分离式冷凝器，蒸汽机效率倍增——煤的能量第一次被驯服为万能动力，工业革命的引擎点火。',
      facts: ['同一年《独立宣言》发表——动力与思想的"双革命"', '"马力"单位是瓦特为营销而发明的'] },
    { id: 'bulb', cat: 'civ', ago: 1.47e2, imp: 2, title: '电灯照亮夜晚', en: 'Electric Light',
      desc: '爱迪生与斯旺让白炽灯实用化，城市从此不夜；电网铺开，"三班倒"的现代节奏开始。',
      facts: ['爱迪生团队试验了约1600种灯丝材料', '人类历史上第一次，深夜可以被点亮'] },
    { id: 'darwin', cat: 'sci', ago: 1.67e2, imp: 3, title: '《物种起源》', en: 'On the Origin of Species',
      desc: '达尔文以自然选择解释生命的演化——小猎犬号五年环球观察，结出"生命之树"的钥匙。',
      facts: ['环球航行5年，他晕船也晕了5年', '加拉帕戈斯地雀的喙是"选择"的活教具', '首版1250册在出版首日售罄'] },
    { id: 'maxwell', cat: 'sci', ago: 1.61e2, imp: 2, title: '麦克斯韦方程组', en: 'Maxwell\'s Equations',
      desc: '四组方程统一电、磁、光——"光是电磁波"。无线通信的大门由此打开。',
      facts: ['方程预言的电磁波速度与光速一致——光的"身份"之谜解开', '爱因斯坦书房里挂着牛顿与麦克斯韦的肖像'] },
    { id: 'mendeleev', cat: 'sci', ago: 1.57e2, imp: 2, title: '元素周期表', en: 'The Periodic Table',
      desc: '门捷列夫按原子量排出元素"座次"，还敢给未知元素留空位并预言它们的性质。',
      facts: ['镓、锗被发现时，性质与预言惊人吻合', '2019年是元素周期表诞生150周年'] },
    { id: 'cinema', cat: 'art', ago: 1.31e2, imp: 2, title: '电影诞生', en: 'Birth of Cinema',
      desc: '卢米埃尔兄弟在巴黎咖啡馆放映《火车进站》，据传观众惊叫躲闪——"第七艺术"开场。',
      facts: ['最早的影片只有几十秒', '卓别林《摩登时代》讽刺的流水线，正是工业时代的自画像'] },
    { id: 'wright', cat: 'sci', ago: 1.23e2, imp: 2, title: '莱特兄弟首飞', en: 'The First Flight',
      desc: '基蒂霍克沙滩上12秒、36米的飞行——动力航空元年。',
      facts: ['那天的飞行距离，比今天一架客机的翼展还短', '从首飞到喷气客机只用了66年', '莱特兄弟开过自行车铺，风洞是自己搭的'] },
    { id: 'einstein', cat: 'sci', ago: 1.21e2, imp: 2, title: '相对论', en: 'Relativity',
      desc: '1905"奇迹年"狭义相对论，1915广义相对论：时间与空间会随速度与引力而弯曲。',
      facts: ['E=mc²揭示质量是能量的"储蓄罐"', 'GPS卫星每天要按相对论修正约38微秒，否则导航会漂移', '1919年日食观测证实星光被太阳弯曲，爱因斯坦一夜封神'] },
    { id: 'ww1', cat: 'civ', ago: 1.12e2, imp: 2, title: '第一次世界大战', en: 'World War I',
      desc: '帝国竞争引爆欧战，约900万士兵阵亡；旧秩序崩塌，"20世纪"真正开始。',
      facts: ['1914年圣诞，德英士兵曾自发停火踢球', '坦克、战机与化学武器同台首演——技术的双刃剑全功率展现'] },
    { id: 'quantum', cat: 'sci', ago: 1.0e2, imp: 2, title: '量子力学', en: 'Quantum Mechanics',
      desc: '海森堡、薛定谔、玻尔等人重建微观世界的规则：概率、叠加与不确定性——"上帝也掷骰子"。',
      facts: ['没有量子力学，就没有芯片、激光与核磁共振', '薛定谔的猫是思想实验，用来暴露宏观直觉的失效'] },
    { id: 'penicillin', cat: 'sci', ago: 9.8e1, imp: 2, title: '青霉素', en: 'Penicillin',
      desc: '弗莱明度假归来，发现霉菌"吃掉"了葡萄球菌——人类第一剂抗生素，无数感染从此可治。',
      facts: ['青霉素赶上二战量产，拯救的生命以百万计', '抗生素耐药性是今天的"灰犀牛"——合理用药人人有责'] },
    { id: 'ww2', cat: 'civ', ago: 8.7e1, imp: 2, title: '第二次世界大战', en: 'World War II',
      desc: '人类历史上最大规模的战争，数千万人丧生；战后的联合国与新技术格局塑造了今天的世界。',
      facts: ['图灵与盟军密码破译缩短了战争，电子计算机由此起飞', '1945年"三位一体"核试验开启核时代'] },
    { id: 'dna', cat: 'sci', ago: 7.3e1, imp: 3, title: 'DNA双螺旋', en: 'The Double Helix',
      desc: '沃森与克里克（依据富兰克林的X射线照片）解开遗传分子结构——生命是一份可以"复制粘贴"的代码。',
      facts: ['罗莎琳德·富兰克林的"51号照片"是关键证据', '单个细胞的DNA拉直约2米，却塞进了微小的细胞核'] },
    { id: 'sputnik', cat: 'sci', ago: 6.9e1, imp: 2, title: '第一颗人造卫星', en: 'Sputnik 1',
      desc: '哈萨克草原上一声"哔——哔——"，太空时代开启，美苏太空竞赛鸣枪。',
      facts: ['Sputnik意为"旅伴"', '这颗83公斤的小球让美国连夜组建NASA'] },
    { id: 'gagarin', cat: 'sci', ago: 6.5e1, imp: 2, title: '加加林进入太空', en: 'Gagarin in Orbit',
      desc: '108分钟绕地球一圈，人类第一次从太空回望家园："地球是蓝色的。"',
      facts: ['东方一号全程自动控制', '4月12日如今是"世界航天日"'] },
    { id: 'apollo', cat: 'sci', ago: 5.7e1, imp: 3, title: '阿波罗11号登月', en: 'Apollo 11 Moon Landing',
      desc: '"个人的一小步，人类的一大步。"阿姆斯特朗踏上静海——人类第一次踩上另一颗星球。',
      facts: ['登月舱计算机内存仅4KB，却稳定完成导航', '同一年ARPANET上线——太空与网络在同一年出发'] },
    { id: 'arpanet', cat: 'civ', ago: 5.7e1, imp: 2, title: '互联网前身ARPANET', en: 'ARPANET',
      desc: '4台主机连成第一张分组交换网——互联网的第一声啼哭。',
      facts: ['第一条消息本想发"LOGIN"，发出两个字符系统就崩了', '今天全球网民超过50亿'] },
    { id: 'pc', cat: 'civ', ago: 4.7e1, imp: 2, title: '个人电脑革命', en: 'The PC Revolution',
      desc: 'Apple II与IBM PC把计算机从机房搬进书房——"人人可计算"的时代到来。',
      facts: ['摩尔定律：芯片晶体管数约18～24个月翻一番', '图形界面与鼠标来自施乐PARC，苹果与微软发扬光大'] },
    { id: 'www', cat: 'civ', ago: 3.5e1, imp: 3, title: '万维网', en: 'The World Wide Web',
      desc: '蒂姆·伯纳斯-李在CERN写下HTTP与HTML，并免费开放给全人类——信息时代的"公共广场"落成。',
      facts: ['他拒绝了专利，让万维网属于每个人', '第一个网页的内容是"如何建立网页"'] },
    { id: 'genome', cat: 'sci', ago: 2.3e1, imp: 2, title: '人类基因组计划', en: 'Human Genome Project',
      desc: '13年、约30亿美元，测出30亿碱基对——人类的"生命说明书"第一版发布。',
      facts: ['人类基因约2万个，比预想的少得多', '测序成本从30亿美元降到千元级'] },
    { id: 'iphone', cat: 'civ', ago: 1.9e1, imp: 2, title: '智能手机时代', en: 'The Smartphone Era',
      desc: 'iPhone把电话、电脑、相机与互联网合进一块玻璃——人类随身带上了"数字器官"。',
      facts: ['智能手机普及只用了约十年，比电力快得多', '一块手机里的传感器数量超过一辆汽车'] },
    { id: 'higgs', cat: 'sci', ago: 1.4e1, imp: 2, title: '希格斯玻色子', en: 'Higgs Boson',
      desc: '大型强子对撞机找到"上帝粒子"，标准模型最后一块拼图就位——质量的来源被找到。',
      facts: ['LHC周长27公里，横跨法瑞边境', '发现论文的作者署名超过5000人'] },
    { id: 'ligo', cat: 'sci', ago: 1.1e1, imp: 2, title: '引力波探测', en: 'Gravitational Waves',
      desc: 'LIGO"听"到13亿年前两个黑洞合并的"啁啾"——爱因斯坦百年预言成真，宇宙有了"听觉"。',
      facts: ['测量的形变小达质子直径的万分之一', '2017年"多信使"观测开启引力波天文学'] },
    { id: 'alphago', cat: 'sci', ago: 1.0e1, imp: 2, title: 'AlphaGo战胜李世石', en: 'AlphaGo',
      desc: '深度学习在围棋登顶，"第37手"展示了人类未曾想过的下法——机器开始"创造"。',
      facts: ['围棋总变化约10¹⁷⁰种，超过可观测宇宙的原子数', 'AlphaFold随后预测2亿蛋白质结构，改写生物学研究'] },
    { id: 'ai', cat: 'sci', ago: 4, imp: 3, title: 'AI大模型时代', en: 'The Age of AI',
      desc: '大语言模型以对话方式理解与生成内容，AI从实验室工具变成大众助手——"信息文明"的新一轮范式转移正在进行。',
      facts: ['对话式AI让"人人可用"第一次成为现实', '能力边界与伦理正在被全社会共同定义', '下一个年轮由谁书写？也许正是屏幕前的你'] },

    /* ---------- 艺术 🎨 ---------- */
    { id: 'blombos', cat: 'art', ago: 7.3e4, imp: 1, title: '布隆伯斯刻纹', en: 'Blombos Cave Engraving',
      desc: '南非布隆伯斯洞穴的赭石上刻着规则的交叉几何纹——人类最早的"抽象画"之一。',
      facts: ['这块4厘米的小石头，藏着"设计感"的起源', '同洞穴还发现早期颜料作坊'] },
    { id: 'caveart', cat: 'art', ago: 3.6e4, imp: 3, title: '洞穴壁画', en: 'Cave Painting',
      desc: '法国肖维洞穴的狮子、犀牛与奔跑的野马——艺术与"讲故事的心"已经就位。',
      facts: ['肖维洞因落石封洞而保存完好，被称为"史前卢浮宫"', '拉斯科洞窟（约1.7万年前）则被称"史前西斯廷"'] },
    { id: 'parthenon', cat: 'art', ago: 2.48e3, imp: 2, title: '帕特农神庙', en: 'The Parthenon',
      desc: '雅典卫城之巅的多立克神庙，是比例与视觉矫正艺术的巅峰之作。',
      facts: ['柱身微微内倾，看起来却笔直——"视觉修正"的教科书', '雕塑家菲狄亚斯主持了整体设计'] },
    { id: 'beethoven', cat: 'art', ago: 2.01e2, imp: 2, title: '贝多芬《第九交响曲》', en: 'Beethoven\'s Ninth',
      desc: '完全失聪的贝多芬写下《欢乐颂》——"四海之内皆兄弟"被谱成了交响曲。',
      facts: ['首演时他听不见掌声，直到被歌手转身指向观众', '《欢乐颂》后成为欧盟盟歌'] },

    /* ---------- 补充批次：更细的历史肌理 ---------- */
    { id: 'plate', cat: 'earth', ago: 2.7e9, imp: 1, title: '板块运动启动', en: 'Plate Tectonics Begins',
      desc: '地球外壳裂成大小板块，在软流圈上缓慢漂移、碰撞、俯冲——山脉、海沟与地震从此成为地球的"新陈代谢"。',
      facts: ['板块每年移动几厘米，与指甲生长速度相当', '大陆每几亿年就会聚散一次，形成"超级大陆"'] },
    { id: 'sex', cat: 'life', ago: 1.2e9, imp: 1, title: '有性繁殖出现', en: 'Sexual Reproduction',
      desc: '生命学会了"基因洗牌"：两性结合让后代产生多样变异，演化的加速度从此拉满。',
      facts: ['有性繁殖让物种抗风险能力大增', '今天几乎所有复杂生物都是这场"创新"的后代'] },
    { id: 'ozone', cat: 'earth', ago: 5.0e8, imp: 1, title: '臭氧层成形', en: 'The Ozone Layer Forms',
      desc: '氧气在高层大气形成臭氧"防晒盾"，致命紫外线被挡住——生命登陆陆地的大门就此打开。',
      facts: ['没有臭氧层，登陆陆地的植物会直接被晒伤', '今天臭氧空洞的修复是人类环保合作的范例'] },
    { id: 'insects', cat: 'life', ago: 3.5e8, imp: 2, title: '昆虫飞上天空', en: 'Insects Take Flight',
      desc: '昆虫成为第一批飞行动物，比翼龙、鸟类和蝙蝠都早了上亿年——天空第一次有了"住户"。',
      facts: ['蜻蜓的飞行设计 3 亿年几乎没大改', '石炭纪巨脉蜻蜓翼展达 70 厘米'] },
    { id: 'grass', cat: 'life', ago: 8e6, imp: 1, title: '草原大扩张', en: 'Grasslands Expand',
      desc: '草本植物铺满大陆腹地，森林退居一隅——开阔的草原环境被认为是人类祖先走出森林的舞台背景。',
      facts: ['草原促成了马、羚羊等奔跑型动物的演化', '人类的主要粮食（小麦、水稻、玉米）都是草本植物'] },
    { id: 'dujiangyan', cn: 1, cat: 'civ', ago: 2.282e3, imp: 1, title: '都江堰建成', en: 'Dujiangyan Irrigation System',
      desc: '李冰父子主持修建无坝引水工程，"深淘滩、低作堰"让成都平原从此旱涝保收，两千多年仍在服役。',
      facts: ['都江堰是世界上使用时间最长的水利工程师', '它让秦国拥有了稳定的粮仓，为统一奠定经济基础'] },
